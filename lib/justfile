review_dir := if path_exists("review") == "true" { "review" } else { "" }
tests_dir := if path_exists("tests") == "true" { "tests" } else { "" }

# Directories containing Elm code (review and tests only if they exist),
# plus any listed in PROJECT_ELM_DIRS_EXTRA
elm_dirs := trim(replace_regex("src " + review_dir + " " + tests_dir + " " + env("PROJECT_ELM_DIRS_EXTRA", ""), '\s+', ' '))

# Paths for `clean` to remove, from PROJECT_CLEAN_PATHS_EXTRA
clean_paths := trim(replace_regex(".parcel-cache dist elm-stuff node_modules result " + env("PROJECT_CLEAN_PATHS_EXTRA", ""), '\s+', ' '))

[private, default]
default:
  @just --list --unsorted

# Start the development server
dev:
  pnpm dev

# Format the Elm code in place
format:
  elm-format {{elm_dirs}} --yes

# Check the formatting of the Elm code
check-format:
  elm-format {{elm_dirs}} --validate

# Review the Elm code
review:
  if [ -d review ]; then elm-review; else echo "No review directory, skipping."; fi

# Run the Elm tests
test:
  if [ -d tests ]; then elm-test; else echo "No tests directory, skipping."; fi

# Run all the code checks (CI runs this too)
verify: check-format review test

# Build the site for production into ./result
build:
  make build

# Preview the production build locally
preview:
  make preview

# Deploy the production build into the deployBranch branch (site by default)
deploy:
  make deploy

# Remove build artifacts
clean:
  rm -rf {{clean_paths}}

alias d := dev
alias f := format
alias r := review
alias t := test
alias v := verify
alias b := build
alias p := preview
alias c := clean
