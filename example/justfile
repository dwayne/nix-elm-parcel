elm_dirs := "src tests"

[private]
default:
  @just --list --unsorted

# Start the development server
dev:
  pnpm dev

# Run elm-format
format:
  elm-format {{elm_dirs}} --yes

# Run sanity checks
lint:
  elm-format {{elm_dirs}} --validate
  elm-review

# Run the tests
test:
  elm-test

# Remove build artifacts
clean:
  rm -rf .parcel-cache dist elm-stuff node_modules result

alias d := dev
alias f := format
alias l := lint
alias t := test
alias c := clean
