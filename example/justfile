[private]
default:
  @just --list --unsorted

# Start the development server
dev:
  pnpm dev

# Run elm-format
format:
  elm-format src --yes

# Run sanity checks
lint:
  elm-format src --validate

# Remove build artifacts
clean:
  rm -rf .parcel-cache dist elm-stuff node_modules result

alias d := dev
alias f := format
alias l := lint
alias c := clean
